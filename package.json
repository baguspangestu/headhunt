{
  "name": "headhunt",
  "version": "0.1.0",
  "description": "A privacy-focused Arknights: Endfield headhunt tracker and game-data catalog.",
  "private": true,
  "license": "MIT",
  "homepage": "https://headhunt.cc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baguspangestu/headhunt.git"
  },
  "bugs": {
    "url": "https://github.com/baguspangestu/headhunt/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run test && npm run format:check",
    "format": "prettier --write .",
    "predeploy": "node check-deploy.mjs",
    "deploy": "node cloudflare-build.mjs deploy && opennextjs-cloudflare deploy",
    "upload": "node cloudflare-build.mjs upload && opennextjs-cloudflare upload",
    "preview": "node cloudflare-build.mjs preview && opennextjs-cloudflare preview --host 0.0.0.0",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "data:update": "npm run get:guide && npm run get:wiki-catalog && npm run get:wiki-detail && npm run get:pool && npm run generate:content && npm run generate:gear && npm run generate:banner",
    "generate:content": "tsx scripts/generate-content-data.ts",
    "generate:gear": "tsx scripts/generate-gear-data.ts",
    "generate:banner": "tsx scripts/generate-banner-data.ts",
    "get:pool": "tsx scripts/get-game-pool-data.ts",
    "get:guide": "tsx scripts/get-skport-guide-data.ts",
    "get:guide:puppeteer": "tsx scripts/archive/get-skport-guide-data.puppeteer.ts",
    "get:wiki-catalog": "tsx scripts/get-skport-wiki-catalog.ts",
    "get:wiki-catalog:puppeteer": "tsx scripts/archive/get-skport-wiki-catalog.puppeteer.ts",
    "get:wiki-detail": "tsx scripts/get-skport-wiki-detail.ts",
    "get:wiki-detail:puppeteer": "tsx scripts/archive/get-skport-wiki-detail.puppeteer.ts",
    "test": "npm run test:audit && npm run test:tracker-v3",
    "test:audit": "tsx tests/audit-regressions.test.ts",
    "test:tracker-v3": "tsx tests/tracker-v3.test.ts"
  },
  "dependencies": {
    "@next/third-parties": "^16.3.6",
    "@opennextjs/cloudflare": "^1.20.6",
    "clsx": "^2.1.1",
    "lz-string": "^1.5.0",
    "next": "^16.3.6",
    "next-intl": "^4.14.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "puppeteer-core": "^25.12.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.139.0"
  }
}
